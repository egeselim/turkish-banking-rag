<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="Testcontainers.Qdrant" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared synthetic PII generator (Bogus + checksum algorithms). -->
    <Compile Include="..\Assistant.Privacy.Tests\TestData\FakePii.cs" Link="TestData\FakePii.cs" />
    <!-- In-memory SelimBank.Api host, shared with SelimBank.Api.Tests. -->
    <Compile Include="..\SelimBank.Api.Tests\SelimBankApiFactory.cs" Link="Banking\SelimBankApiFactory.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\sources\*.pdf" Link="Sources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\eval\injection.jsonl" Link="Eval\injection.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\eval\questions.jsonl" Link="Eval\questions.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Assistant.Core\Assistant.Core.csproj" />
    <!-- The real telemetry setup (PII scrubbers, OTLP exporter) for TelemetryLeakTests. -->
    <ProjectReference Include="..\..\src\SelimBank.ServiceDefaults\SelimBank.ServiceDefaults.csproj" />
    <!-- Test-only: Core itself reaches the API over HTTP and must not reference it (ArchitectureTests). -->
    <ProjectReference Include="..\..\src\SelimBank.Api\SelimBank.Api.csproj" />
  </ItemGroup>
</Project>
